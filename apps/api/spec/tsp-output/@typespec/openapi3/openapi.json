  "components": {
    "schemas": {
      "ApiKeyCreated": {
        "type": "object",
        "required": [
          "createdAt",
          "id",
          "label",
          "key",
          "keyPrefix"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "keyPrefix": {
            "type": "string"
          }
        }
      },
      "ApiKeyHeaderAuth": {
        "type": "object",
        "required": [
          "type",
          "in",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "apiKey"
            ],
            "description": "API key passed in the x-api-key request header"
          },
          "in": {
            "type": "string",
            "enum": [
              "header"
            ]
          },
          "name": {
            "type": "string",
            "enum": [
              "x-api-key"
            ]
          }
        }
      },
      "ApiKeySummary": {
        "type": "object",
        "required": [
          "createdAt",
          "id",
          "label",
          "keyPrefix",
          "lastUsedAt",
          "revokedAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "keyPrefix": {
            "type": "string"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "revokedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ApiKeysList": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiKeySummary"
            }
          }
        }
      },
      "BadRequestError": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "ClickByBrowser": {
        "type": "object",
        "required": [
          "browser",
          "clicks"
        ],
        "properties": {
          "browser": {
            "type": "string"
          },
          "clicks": {
            "type": "integer"
          }
        }
      },
      "ClickByCountry": {
        "type": "object",
        "required": [
          "country",
          "clicks"
        ],
        "properties": {
          "country": {
            "type": "string"
          },
          "clicks": {
            "type": "integer"
          }
        }
      },
      "ClickByPeriod": {
        "type": "object",
        "required": [
          "period",
          "clicks"
        ],
        "properties": {
          "period": {
            "type": "string"
          },
          "clicks": {
            "type": "integer"
          }
        }
      },
      "ConflictError": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "CreateLinkRequest": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 8192
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ForbiddenError": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "GoneError": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          }
