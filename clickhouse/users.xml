<clickhouse>
    <users>
        <default>
            <!--
                Allow connections from any network interface, including the
                Docker bridge IP that the host uses when connecting through
                port-mapped container ports (e.g. localhost:8123).

                The built-in default restricts access to 127.0.0.1/::1,
                which blocks test clients that reach ClickHouse via the
                Docker bridge (source IP is the bridge gateway, not loopback).
            -->
            <networks>
                <ip>::/0</ip>
            </networks>
        </default>
    </users>
</clickhouse>
