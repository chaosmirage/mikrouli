<clickhouse>
    <users>
        <default>
            <!--
                Password is supplied via the CLICKHOUSE_PASSWORD environment
                variable, which the official clickhouse/clickhouse-server image
                reads directly to set the default user's password at startup.
                No SHA-256 templating is needed in compose — the image handles it.
                Network access is open to any Docker bridge IP so the api
                container can reach ClickHouse over the internal Docker network.
            -->
            <networks>
                <ip>::/0</ip>
            </networks>
        </default>
    </users>
</clickhouse>
