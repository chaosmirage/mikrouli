# ============================================================
# mikrouli — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Used by: docker-compose.yml, apps/api (local dev)
# Never commit .env — it is gitignored.
# ============================================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=change-me-to-a-strong-password
DB_NAME=mikrouli

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-to-a-strong-redis-password

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_PASSWORD=change-me-to-a-strong-clickhouse-password

# JWT Authentication
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars

# GitHub OAuth (sign in / register with GitHub)
# Create an OAuth App at https://github.com/settings/developers and set the
# Authorization callback URL to GITHUB_CALLBACK_URL below (one app per environment).
GITHUB_CLIENT_ID=change-me-to-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=change-me-to-your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:8888/api/auth/github/callback

# Node environment
NODE_ENV=development

# Number of trusted reverse-proxy hops in front of the API.
# compose: 1 (one nginx hop); k8s: 2 (traefik + web-nginx).
# Optional — defaults to 1 when unset.
TRUST_PROXY_HOPS=1

# Public base URL used to build shareable short links.
# The MCP tool returns this + "/" + slug as the full usable link.
# Trim trailing slashes; no trailing slash expected.
PUBLIC_BASE_URL=https://mikrou.li

# Monthly usage limits (per-user DB override takes precedence over these defaults).
MONTHLY_LINK_LIMIT=100   # default monthly short-link allowance per user
MONTHLY_KEY_LIMIT=10     # default monthly API-key allowance per user

# Guest shorten on the landing page. When true, anonymous visitors can shorten
# URLs via POST /api/urls without an account (attributed to a single shared
# Guest row; no per-user quota). Toggle at runtime: change the value and
# restart the api and the web/nginx containers (no rebuild needed). The SPA
# reads this via an njs-served /config.js; the API re-reads it per request.
GUEST_SHORTEN_ENABLED=true

# docker compose profile selection.
#   prod (default) -> production-shaped stack: web served by the nginx static
#     image behind nginx on :8888. This is what CI's e2e job and `docker compose
#     up` use.
#   For local frontend development with vite HMR, override on the CLI instead:
#     docker compose --profile dev up
#   (the dev profile swaps in web-dev (vite) + nginx-dev on :8888).
COMPOSE_PROFILES=prod
